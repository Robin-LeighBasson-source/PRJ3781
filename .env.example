# Copy to .env to override the defaults in docker-compose.yml. Every value is
# optional except MONGODB_URI; server/README.md documents the full set the
# crawler understands.

# Required. Accounts, resumes and product requests are stored in MongoDB.
# MONGODB_URI=mongodb://127.0.0.1:27017/morrow

# Required for the production stack (docker-compose.prod.yml). Caddy uses these
# to obtain the Let's Encrypt certificate; DNS must already point at the VPS.
# DOMAIN=morrow.example.com
# ACME_EMAIL=you@example.com

# Crawler identity. Set this to a real contact URL before pointing the crawler at
# anything outside a local experiment.
# MORROW_USER_AGENT=MorrowBot/0.1 (+https://example.com/about-crawler; you@example.com)

# Run the daily scheduled crawl inside the container. Off by default so a
# container started to look at the UI does not begin crawling on its own.
# MORROW_CRAWL_SCHEDULE_ENABLED=1

# Required for the Firecrawl-based crawlers (crawl:jobs, crawl:hackathons and
# the course crawler). jobCrawler.env is git-ignored, so set the key here on the
# VPS instead. The certification crawler does not use it.
# FIRECRAWL_API_KEY=fc-...

# Per-provider toggles.
# MICROSOFT_LEARN_ENABLED=1
# COURSERA_ENABLED=1

# Strict robots posture for Coursera; see server/README.md for the tension here.
# COURSERA_USE_CATALOG_API=0

# Comma-separated browser origins allowed to call the API directly. Origins are
# scheme://host[:port] with no trailing slash.
# Local development:
# MORROW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# On the VPS (optional): docker-compose.prod.yml already defaults this to
# https://DOMAIN, so only set it to add origins such as www.
# MORROW_CORS_ORIGINS=https://morrow.example.com,https://www.morrow.example.com

# Login sessions and sign-up/login rate limiting.
# MORROW_SESSION_TTL_HOURS=8
# MORROW_LOGIN_WINDOW_MINUTES=15
# MORROW_LOGIN_MAX_ATTEMPTS=8
