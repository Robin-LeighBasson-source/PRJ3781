# Caddy obtains and renews the Let's Encrypt certificate automatically for
# $DOMAIN, as long as DNS points at this VPS and ports 80/443 are reachable.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	root * /srv

	# The API is reached directly, so Caddy's X-Forwarded-For is the only proxy
	# hop the app has to trust (see `trust proxy` in app.js).
	handle /api/* {
		reverse_proxy api:8787
	}

	# The built React bundle. React Router owns the route table, so any path
	# that is not a real file returns index.html instead of a 404.
	handle {
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format console
	}
}
